{
  "name": "@openreturn/cade",
  "version": "0.1.0",
  "private": true,
  "description": "Cade, the AI CPA: a Mastra backend. The conversational agent orchestrates fact-gathering and form generation; every AI decision is grounded by Canon (the tax attorney, its own Mastra project) over MCP.",
  "scripts": {
    "predev": "npm run sources:sync",
    "dev": "mastra dev --env .env.development",
    "prebuild": "npm run sources:sync",
    "build": "mastra build --studio",
    "start": "cd .mastra/output && node index.mjs",
    "reset:data": "rm -f .data/app.db .data/app.db-shm .data/app.db-wal .data/mastra.db .data/mastra.db-shm .data/mastra.db-wal && rm -rf .data/documents && echo 'Factory reset done (corpus.db preserved). Restart the dev servers and visit http://localhost:3000/setup.'",
    "smoke:review": "tsx scripts/smokeReview.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit -p .",
    "sources:sync": "tsx scripts/syncSources.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@mastra/core": "^1.79.0",
    "@mastra/libsql": "^1.27.0",
    "@mastra/mcp": "^1.18.0",
    "@mastra/memory": "^1.39.0",
    "@mastra/observability": "^1.21.0",
    "@napi-rs/canvas": "^0.1.100",
    "@openreturn/engine": "0.1.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "mastra": "^1.35.0",
    "unpdf": "^1.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@openreturn/sources": "0.1.0",
    "@types/node": "^22",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
